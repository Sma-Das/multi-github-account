#!/usr/bin/env python3
"""Offline gh fixture. Refuse ambient tokens and never mutate the active user."""
import json
import os
import sys
import time

args = sys.argv[1:]
if args[:2] == ["auth", "status"]:
    if any(os.environ.get(k) for k in ("GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN", "GITHUB_ENTERPRISE_TOKEN")):
        sys.exit(8)
    print(json.dumps({"hosts": {"github.com": [
        {"login": "user-1", "state": "success", "active": True, "tokenSource": "keyring"},
        {"login": "user-2", "state": "success", "active": False, "tokenSource": "keyring"},
    ], "git.example.com": [
        {"login": "user-2", "state": "success", "active": True, "tokenSource": "keyring"}
    ]}}))
elif args[:2] == ["auth", "token"]:
    if any(os.environ.get(k) for k in ("GH_TOKEN", "GITHUB_TOKEN", "GH_ENTERPRISE_TOKEN", "GITHUB_ENTERPRISE_TOKEN")):
        sys.exit(8)
    if os.environ.get("GH_DEBUG"):
        sys.exit(9)
    user = args[args.index("--user") + 1]
    if user not in ("user-1", "user-2"):
        sys.exit(1)
    time.sleep(0.02)
    print("fixture-token-" + user)
elif args[:2] == ["api", "/user"]:
    print(os.environ.get("GH_TOKEN") or os.environ.get("GH_ENTERPRISE_TOKEN"))
else:
    sys.exit(7)
